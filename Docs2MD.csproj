<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PlatformTarget>x64</PlatformTarget>
    <AssemblyName>Docs2MD</AssemblyName>
    <RootNamespace>Docs2MD</RootNamespace>
    <ApplicationHighDpiMode>SystemAware</ApplicationHighDpiMode>
  </PropertyGroup>

  <ItemGroup>
    <!-- Markdown -> HTML (viewer + exporter) -->
    <PackageReference Include="Markdig" Version="0.38.*" />
    <!-- Embedded Chromium browser (viewer) -->
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.*" />
    <!-- Word export: OpenXML SDK -->
    <PackageReference Include="DocumentFormat.OpenXml" Version="2.*" />
    <!-- Excel export -->
    <PackageReference Include="ClosedXML" Version="0.102.*" />
    <!-- DOCX -> HTML -->
    <PackageReference Include="Mammoth" Version="1.*" />
    <!-- HTML -> Markdown -->
    <PackageReference Include="ReverseMarkdown" Version="4.6.0" />
    <!-- PDF text extraction -->
    <PackageReference Include="PdfPig" Version="0.1.9" />
    <!-- PDF page rasterisation (PDFium) for OCR -->
    <PackageReference Include="Docnet.Core" Version="2.6.0" />
    <!-- OCR engine (bundles win-x64 native dlls) -->
    <PackageReference Include="Tesseract" Version="5.2.0" />
    <!-- Raw BGRA -> PNG for Tesseract input -->
    <PackageReference Include="SixLabors.ImageSharp" Version="3.1.*" />
    <!-- Modern WPF-style Material Design UI -->
    <PackageReference Include="MaterialSkin.2" Version="2.*" />
    <!-- SVG renderer for logo -->
    <PackageReference Include="Svg" Version="3.*" />
  </ItemGroup>

  <ItemGroup>
    <!-- Ship tessdata next to the exe if present -->
    <None Include="tessdata\**" CopyToOutputDirectory="PreserveNewest" />
    <!-- Embed brand logo into the assembly -->
    <EmbeddedResource Include="logo.svg" />
  </ItemGroup>

</Project>
