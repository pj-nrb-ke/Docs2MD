<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>Docs2MD.Core</AssemblyName>
    <RootNamespace>Docs2MD</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- Markdown parse/render and export -->
    <PackageReference Include="Markdig" Version="0.38.*" />
    <!-- Word export -->
    <PackageReference Include="DocumentFormat.OpenXml" Version="2.*" />
    <!-- Excel export -->
    <PackageReference Include="ClosedXML" Version="0.102.*" />
    <!-- DOCX -> HTML -->
    <PackageReference Include="Mammoth" Version="1.*" />
    <!-- HTML -> Markdown -->
    <PackageReference Include="ReverseMarkdown" Version="4.6.0" />
    <!-- PDF text extraction -->
    <PackageReference Include="PdfPig" Version="0.1.9" />
    <!-- PDF page rasterisation (PDFium) for OCR -->
    <PackageReference Include="Docnet.Core" Version="2.6.0" />
    <!-- OCR engine -->
    <PackageReference Include="Tesseract" Version="5.2.0" />
    <!-- Raw BGRA -> PNG for Tesseract input -->
    <PackageReference Include="SixLabors.ImageSharp" Version="3.1.*" />
  </ItemGroup>

</Project>
