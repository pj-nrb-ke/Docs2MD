<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PlatformTarget>x64</PlatformTarget>
    <AssemblyName>Docs2MD</AssemblyName>
    <RootNamespace>Docs2MD</RootNamespace>
    <ApplicationHighDpiMode>SystemAware</ApplicationHighDpiMode>
    <UseAppHost>true</UseAppHost>
  </PropertyGroup>

  <ItemGroup>
    <!-- Embedded Chromium browser (MD viewer) -->
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.*" />
    <!-- Material Design UI -->
    <PackageReference Include="MaterialSkin.2" Version="2.*" />
    <!-- SVG logo renderer -->
    <PackageReference Include="Svg" Version="3.*" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Docs2MD.Core\Docs2MD.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Ship tessdata next to the exe if present -->
    <None Include="..\tessdata\**" CopyToOutputDirectory="PreserveNewest"
          Link="tessdata\%(RecursiveDir)%(Filename)%(Extension)" />
    <!-- Embed brand logo into the assembly -->
    <EmbeddedResource Include="logo.svg" />
  </ItemGroup>

</Project>
