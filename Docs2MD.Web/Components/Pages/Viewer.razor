@page "/viewer"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@rendermode InteractiveServer
@inject IJSRuntime JS
@inject ConversionState State
@using Markdig
@using Docs2MD

<PageTitle>Viewer – Docs2MD</PageTitle>

<div class="viewer-page">
    <div class="viewer-toolbar">
        <label class="btn-browse viewer-upload">
            Open .md file
            <InputFile OnChange="OnFileLoaded" accept=".md" style="display:none" />
        </label>
        <button class="btn-action" @onclick="PasteMarkdown">Paste Markdown</button>
        @if (!string.IsNullOrWhiteSpace(_markdown))
        {
            <button class="btn-action" @onclick="ExportWord">Export to Word</button>
            <button class="btn-action" @onclick="ExportExcel">Export to Excel</button>
            <button class="btn-action @(_copied ? "btn-action-copied" : "")" @onclick="CopyPreview">@_copyLabel</button>
            <button class="btn-action @(_selCopied ? "btn-action-copied" : "")" @onclick="CopySelected">@_copySelLabel</button>
        }
    </div>

    @if (_loading)
    {
        <div class="viewer-placeholder">
            <span class="spinner"></span> Loading…
        </div>
    }
    else
    {
        <div class="viewer-split">
            <div class="viewer-pane viewer-source">
                <div class="pane-label">Markdown</div>
                <textarea class="md-source" value="@_markdown"
                          @oninput="OnSourceChanged" spellcheck="false"
                          placeholder="Paste or type Markdown here…"></textarea>
            </div>
            <div class="viewer-pane viewer-rendered">
                <div class="pane-label">Preview</div>
                <div class="md-preview" @ref="_previewRef">
                    @if (!string.IsNullOrEmpty(_html))
                    {
                        @((MarkupString)_html)
                    }
                    else
                    {
                        <p class="preview-hint">Open or paste Markdown to preview it here.</p>
                    }
                </div>
            </div>
        </div>
    }
</div>

@code {
    private string _markdown = "";
    private string _html = "";
    private bool _loading;
    private ElementReference _previewRef;
    private string _copyLabel    = "Copy Preview";
    private bool   _copied;
    private string _copySelLabel = "Copy Selected";
    private bool   _selCopied;

    private static readonly MarkdownPipeline _pipeline =
        new MarkdownPipelineBuilder().UseAdvancedExtensions().Build();

    protected override void OnInitialized()
    {
        if (State.HasResult)
        {
            _markdown = State.Markdown ?? "";
            RenderHtml();
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_loading && !string.IsNullOrEmpty(_html))
        {
            try
            {
                await JS.InvokeVoidAsync("enhancePreviewCopy",       _previewRef);
                await JS.InvokeVoidAsync("setupPreviewContextMenu",  _previewRef);
            }
            catch { }
        }
    }

    private async Task OnFileLoaded(InputFileChangeEventArgs e)
    {
        _loading = true;
        StateHasChanged();

        using var reader = new System.IO.StreamReader(e.File.OpenReadStream(10 * 1024 * 1024));
        _markdown = await reader.ReadToEndAsync();
        RenderHtml();

        _loading = false;
    }

    private void OnSourceChanged(ChangeEventArgs e)
    {
        _markdown = e.Value?.ToString() ?? "";
        RenderHtml();
    }

    private void RenderHtml()
    {
        _html = Markdown.ToHtml(_markdown, _pipeline);
    }

    private async Task PasteMarkdown()
    {
        try
        {
            var text = await JS.InvokeAsync<string>("readClipboardText");
            if (!string.IsNullOrEmpty(text))
            {
                _markdown = text;
                RenderHtml();
            }
        }
        catch { }
    }

    private async Task CopyPreview()
    {
        if (string.IsNullOrEmpty(_html)) return;
        try
        {
            var wrapped = $"<div style=\"font-family:Calibri,Arial,sans-serif;color:#1a2233;line-height:1.6;\">{_html}</div>";
            await JS.InvokeVoidAsync("copyHtmlToClipboard", wrapped, _markdown);
            _copied = true;
            _copyLabel = "Copied!";
            StateHasChanged();
            await Task.Delay(2000);
            _copied = false;
            _copyLabel = "Copy Preview";
        }
        catch { }
    }

    private async Task CopySelected()
    {
        try
        {
            var hadSelection = await JS.InvokeAsync<bool>("copySelectedToClipboard", true);
            if (!hadSelection)
            {
                _copySelLabel = "Nothing selected";
                StateHasChanged();
                await Task.Delay(1500);
                _copySelLabel = "Copy Selected";
                return;
            }
            _selCopied    = true;
            _copySelLabel = "Copied!";
            StateHasChanged();
            await Task.Delay(2000);
            _selCopied    = false;
            _copySelLabel = "Copy Selected";
        }
        catch { }
    }

    private async Task ExportWord()
    {
        if (string.IsNullOrEmpty(_markdown)) return;
        var bytes = await Task.Run(() =>
        {
            var tmp = System.IO.Path.GetTempFileName() + ".docx";
            MdExporter.ToWord(_markdown, tmp);
            var data = System.IO.File.ReadAllBytes(tmp);
            System.IO.File.Delete(tmp);
            return data;
        });
        var b64 = System.Convert.ToBase64String(bytes);
        await JS.InvokeVoidAsync("downloadBase64", "document.docx",
            "application/vnd.openxmlformats-officedocument.wordprocessingml.document", b64);
    }

    private async Task ExportExcel()
    {
        if (string.IsNullOrEmpty(_markdown)) return;
        var bytes = await Task.Run(() =>
        {
            var tmp = System.IO.Path.GetTempFileName() + ".xlsx";
            MdExporter.ToExcel(_markdown, tmp);
            var data = System.IO.File.ReadAllBytes(tmp);
            System.IO.File.Delete(tmp);
            return data;
        });
        var b64 = System.Convert.ToBase64String(bytes);
        await JS.InvokeVoidAsync("downloadBase64", "export.xlsx",
            "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet", b64);
    }
}
