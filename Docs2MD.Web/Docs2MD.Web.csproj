<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Docs2MD.Web</AssemblyName>
    <RootNamespace>Docs2MD.Web</RootNamespace>
    <UserSecretsId>docs2md-web-secrets</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <!-- Google + Microsoft OAuth -->
    <PackageReference Include="Microsoft.AspNetCore.Authentication.Google" Version="8.*" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.MicrosoftAccount" Version="8.*" />
    <!-- Identity with EF Core -->
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="8.*" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="8.*" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="8.*" />
    <!-- Markdown rendering (server-side preview) -->
    <PackageReference Include="Markdig" Version="0.38.*" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Docs2MD.Core\Docs2MD.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Copy tessdata from repo root next to the published web app -->
    <None Include="..\tessdata\**" CopyToOutputDirectory="PreserveNewest"
          Link="tessdata\%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
